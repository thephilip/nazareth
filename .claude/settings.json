{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "nazareth context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nazareth nudge"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(nazareth decide:*)",
      "Bash(nazareth constrain:*)",
      "Bash(nazareth answer:*)",
      "Bash(nazareth resolve:*)",
      "Bash(nazareth retire:*)",
      "Bash(nazareth phase:*)",
      "Bash(nazareth log:*)"
    ],
    "allow": [
      "mcp__nazareth",
      "mcp__lens-memory"
    ]
  }
}
